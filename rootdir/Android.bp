// Init scripts
sh_binary {
    name: "gps.sh",
    src: "bin/gps.sh",
    vendor: true,
}

sh_binary {
    name: "enable_test_mode.sh",
    src: "bin/enable_test_mode.sh",
    vendor: true,
}

sh_binary {
    name: "hdm_status.sh",
    src: "bin/hdm_status.sh",
    vendor: true,
}

sh_binary {
    name: "init.insmod.sh",
    src: "bin/init.insmod.sh",
    vendor: true,
}

sh_binary {
    name: "install-recovery.sh",
    src: "bin/install-recovery.sh",
    vendor: true,
}

sh_binary {
    name: "mx_log_collection.sh",
    src: "bin/mx_log_collection.sh",
    vendor: true,
}

sh_binary {
    name: "mx_logger.sh",
    src: "bin/mx_logger.sh",
    vendor: true,
}

sh_binary {
    name: "mx_logger_dump.sh",
    src: "bin/mx_logger_dump.sh",
    vendor: true,
}

// Init configuration files
// fstab for vendor/etc
prebuilt_etc {
    name: "fstab.s5e8835",
    src: "etc/fstab.s5e8835",
    vendor: true,
}

// fstab for ramdisk (recovery)
prebuilt_etc {
    name: "fstab.s5e8835.ramdisk",
    src: "etc/fstab.s5e8835",
    sub_dir: "",
    ramdisk: true,
}

// fstab for vendor_ramdisk (first_stage_mount)
prebuilt_etc {
    name: "fstab.s5e8835.vendor_ramdisk",
    src: "etc/fstab.s5e8835",
    sub_dir: "",
    vendor_ramdisk: true,
}

// Soong namespace for device tree
soong_namespace {}

// FT3419 touchscreen firmware (Samsung firmware-usher format)
// Source: /vendor/firmware/ft3419_a26x.bin
prebuilt_etc {
    name: "ft3419_firmware",
    src: "etc/firmware/ft3419_a26x.bin",
    sub_dir: "firmware",
    vendor: true,
}

// Samsung device policy (dpolicy) configuration
// Source: /vendor/etc/dpolicy
prebuilt_etc {
    name: "dpolicy",
    src: "etc/dpolicy/dpolicy",
    sub_dir: "dpolicy",
    vendor: true,
}
