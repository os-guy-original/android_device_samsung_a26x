# Camera ISP / IPU access (Exynos)
allow hal_camera_default dmabuf_device:chr_file { open read write ioctl };
allow hal_camera_default sysfs_gpu:dir search;
allow hal_camera_default sysfs_gpu:file { open read getattr };
# Camera EEPROM data
allow hal_camera_default efs_block_device:chr_file { open read };

# =============================================================================
# DRM HAL (Widevine + Clearkey)
