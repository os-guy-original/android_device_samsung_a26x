# Samsung vendor domains
type vendor_hal_samsung, domain;
type vendor_hal_samsung_camera, domain;
type vendor_hal_samsung_radio, domain;
type vendor_hal_samsung_audio, domain;
type vendor_hal_samsung_fingerprint, domain;

# =============================================================================
# Audio HAL
# =============================================================================
allow hal_audio_default camera_fw_file:dir search;
allow hal_audio_default audio_config_file:dir search;
allow hal_audio_default audio_config_file:file { open read getattr map };
allow hal_audio_default vendor_firmware_file:dir search;
allow hal_audio_default vendor_firmware_file:file { open read getattr map };
allow hal_audio_default vendor_samsung_audio_prop:file read;
allow hal_audio_default sysfs_audio:dir search;
allow hal_audio_default sysfs_audio:file { open read getattr };
# Samsung A-Box (Audio Box) DSP access
allow hal_audio_default sec_block_device:chr_file { open read write ioctl };
allow hal_audio_default vendor_samsung_prop:file read;

# =============================================================================
# Bluetooth HAL
# =============================================================================
allow hal_bluetooth_default bt_firmware_file:dir search;
allow hal_bluetooth_default bt_firmware_file:file { open read getattr map };
allow hal_bluetooth_default vendor_firmware_file:dir search;
allow hal_bluetooth_default vendor_firmware_file:file { open read getattr map };
allow hal_bluetooth_default vendor_samsung_bluetooth_prop:file read;
allow hal_bluetooth_default sec_block_device:chr_file { open read write ioctl };
allow hal_bluetooth_default mif_device:chr_file { open read write ioctl };
# Samsung SIPC (inter-processor comm) for BT
allow hal_bluetooth_default sipc_device:chr_file { open read write ioctl };
allow hal_bluetooth_default shm_device:chr_file { open read write ioctl };
# BT MAC address from EFS
allow hal_bluetooth_default efs_block_device:chr_file { open read };
allow hal_bluetooth_default sec_efs_file:dir search;
allow hal_bluetooth_default sec_efs_file:file { open read getattr };

# =============================================================================
# Camera HAL
# =============================================================================
allow hal_camera_default camera_fw_file:dir search;
