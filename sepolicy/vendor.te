allow hal_drm_default widevine_data_file:dir create_dir_perms;
allow hal_drm_default widevine_data_file:file create_file_perms;
allow hal_drm_default vendor_drm_prop:file read;
allow hal_drm_default vendor_widevine_prop:file read;
allow hal_drm_default vendor_firmware_file:dir search;
allow hal_drm_default vendor_firmware_file:file { open read getattr map };
allow hal_drm_default tee_device:chr_file { open read write ioctl };
# Samsung TEEgris for Widevine
allow hal_drm_default keystorage_device:chr_file { open read };

